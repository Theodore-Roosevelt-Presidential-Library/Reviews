# Everything under data/derived/ is generated by collector/derive.py from
# data/reviews.json. Never hand-merge these files — a conflict here once shipped
# "<<<<<<< HEAD" markers into metrics.json and took the dashboard down.
#
# On a conflict: take either side, then run `python3 collector/derive.py` to
# regenerate, and `python3 collector/validate.py` to confirm before committing.
data/derived/*.json   linguist-generated=true
data/snapshots/*.json linguist-generated=true

# reviews.json is append-mostly and large; keep diffs readable but treat it as data.
data/reviews.json     linguist-generated=true
